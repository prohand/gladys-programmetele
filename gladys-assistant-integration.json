          }
        },
        {
          "value": "Numero23.fr",
          "label": {
            "en": "RMC Story",
            "fr": "RMC Story"
          }
        },
        {
          "value": "RMCDecouverte.fr",
          "label": {
            "en": "RMC Découverte",
            "fr": "RMC Découverte"
          }
        },
        {
          "value": "Cherie25.fr",
          "label": {
            "en": "RMC Life",
            "fr": "RMC Life"
          }
        },
        {
          "value": "LCI.fr",
          "label": {
            "en": "LCI",
            "fr": "LCI"
          }
        },
        {
          "value": "FranceInfo.fr",
          "label": {
            "en": "franceinfo:",
            "fr": "franceinfo:"
          }
        },
        {
          "value": "ParisPremiere.fr",
          "label": {
            "en": "Paris Première",
            "fr": "Paris Première"
          }
        },
        {
          "value": "CanalPlusSport.fr",
          "label": {
            "en": "Canal+ Sport",
            "fr": "Canal+ Sport"
          }
        },
        {
          "value": "CanalPlusCinema.fr",
          "label": {
            "en": "Canal+ Cinéma",
            "fr": "Canal+ Cinéma"
          }
        },
        {
          "value": "PlanetePlus.fr",
          "label": {
            "en": "Planète+",
            "fr": "Planète+"
          }
        }
      ]
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often the now / next / tonight sensors are refreshed, in seconds. The guide itself is only downloaded every 6 hours.",
        "fr": "Fréquence de mise à jour des capteurs en cours / à suivre / ce soir, en secondes. Le programme lui-même n'est téléchargé que toutes les 6 heures."
      },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "test_guide",
      "label": {
        "en": "Test the TV guide",
        "fr": "Tester le programme TV"
      },
      "timeout_seconds": 90
    }
  ]
}

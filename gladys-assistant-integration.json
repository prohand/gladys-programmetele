{
  "manifest_version": 1,
  "type": "device",
  "name": "Programme Télé",
  "description": {
    "en": "French TV guide (TNT): what is on now, next and tonight on your favourite channels.",
    "fr": "Programme TV (TNT) : ce qui passe maintenant, ensuite et ce soir sur vos chaînes préférées.",
    "de": "Französisches TV-Programm (TNT): jetzt, danach und heute Abend auf deinen Lieblingssendern.",
    "es": "Guía de TV francesa (TNT): lo que se emite ahora, después y esta noche en sus cadenas favoritas."
  },
  "version": "2.3.1",
  "docker_image": "ghcr.io/prohand/gladys-programmetele:2.3.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-programmetele/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Pick the channels to follow: each one becomes a device with 3 sensors (now, next, tonight). The guide comes from the free XMLTV feed of xmltvfr.fr. No account, no API key.",
        "fr": "Choisissez les chaînes à suivre : chacune devient un appareil avec 3 capteurs (en cours, à suivre, ce soir). Le programme vient du flux XMLTV gratuit de xmltvfr.fr. Pas de compte, pas de clé d'API.",
        "de": "Wähle die Sender aus, die du verfolgen möchtest: Jeder wird zu einem Gerät mit 3 Sensoren (jetzt, danach, heute Abend). Das Programm stammt aus dem kostenlosen XMLTV-Feed von xmltvfr.fr. Kein Konto, kein API-Schlüssel.",
        "es": "Elija las cadenas que desea seguir: cada una se convierte en un dispositivo con 3 sensores (ahora, a continuación, esta noche). La programación procede del feed XMLTV gratuito de xmltvfr.fr. Sin cuenta ni clave de API."
      },
      "links": [
        {
          "url": "https://xmltvfr.fr",
          "label": {
            "en": "XMLTV source (xmltvfr.fr)",
            "fr": "Source XMLTV (xmltvfr.fr)",
            "de": "XMLTV-Quelle (xmltvfr.fr)",
            "es": "Fuente XMLTV (xmltvfr.fr)"
          }
        }
      ]
    },
    {
      "key": "channels",
      "type": "multi_select",
      "label": {
        "en": "Channels",
        "fr": "Chaînes",
        "de": "Sender",
        "es": "Cadenas"
      },
      "description": {
        "en": "One Gladys device is created per selected channel.",
        "fr": "Un appareil Gladys est créé par chaîne cochée.",
        "de": "Für jeden ausgewählten Sender wird ein Gladys-Gerät erstellt.",
        "es": "Se crea un dispositivo de Gladys por cada cadena seleccionada."
      },
      "required": true,
      "default": ["TF1.fr", "France2.fr", "France3.fr", "France5.fr", "M6.fr", "Arte.fr"],
